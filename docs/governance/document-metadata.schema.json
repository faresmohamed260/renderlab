{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "renderlab-document-metadata.schema.json",
  "title": "RenderLab documentation governance metadata",
  "type": "object",
  "required": ["$schema", "schemaVersion", "documents"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"const": "./document-metadata.schema.json"},
    "schemaVersion": {"const": 1},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/document"}
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "required": ["path", "kind", "authority", "lifecycle", "ownerRole", "lastReviewed", "reviewIntervalDays", "supersedes", "supersededBy"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "kind": {"enum": ["entry-point", "normative-policy", "current-state-registry", "current-state-tracker", "implementation-contract", "operations-runbook", "historical-evidence", "reference-guide"]},
        "authority": {"enum": ["normative", "current-state", "historical", "reference"]},
        "lifecycle": {"enum": ["current", "closed", "historical", "superseded"]},
        "ownerRole": {"enum": ["engineering", "product", "product-design", "security-operations", "infrastructure"]},
        "lastReviewed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "reviewIntervalDays": {"type": ["integer", "null"], "minimum": 1, "maximum": 365},
        "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "supersededBy": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
