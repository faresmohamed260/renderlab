{
  "schema_version": "1.0",
  "id": "ltx-video",
  "version": "1.0.0",
  "display_name": "LTX Video",
  "description": "Quantized LTX 2.3 image-to-video generation with multi-image references, auto sizing, duration, frame rate, and native audio controls.",
  "category": "video",
  "model_family": "ltx-video",
  "tags": ["video", "image-to-video", "audio", "quantized"],
  "enabled": true,
  "workflow": {"path": "../workflows/reference_exports/ltx-director.api.json"},
  "capabilities": ["image_to_video", "multi_reference", "reference_mentions", "auto_size", "audio", "lora", "seed", "steps", "duration", "frame_rate", "resolution", "aspect_ratio", "model_selection"],
  "result_actions": ["view", "download", "reuse_prompt", "reuse_settings", "favorite", "details"],
  "inputs": [
    {"id": "prompt", "type": "text", "required": true, "label": "Motion prompt", "mapping": {"node": "131", "input": "local_prompts", "transform": "ltx_prompt"}},
    {"id": "start_image", "type": "asset", "required": true, "label": "Images", "role": "start_image", "accepted_media": ["image/*"], "multiplicity": {"min": 1, "max": 24}, "mapping": {"node": "131", "input": "timeline_data", "transform": "ltx_image_timeline"}}
  ],
  "parameters": [
    {"id": "resolution", "type": "enum", "default": "480p", "options": ["480p", "720p", "1080p", "2K", "4K"], "label": "Resolution", "section": "quick", "control": "resolution"},
    {"id": "aspect_ratio", "type": "enum", "default": "auto", "options": ["auto", "2:3", "3:2", "1:1", "9:16", "16:9"], "label": "Aspect ratio", "section": "quick", "control": "aspect_ratio"},
    {"id": "frame_rate", "type": "enum", "default": 24, "options": [16, 24, 30], "label": "Frame rate", "section": "advanced", "control": "frame_rate", "mapping": {"node": "131", "input": "frame_rate"}},
    {"id": "duration_seconds", "type": "enum", "default": 6, "options": [6, 10], "label": "Duration", "section": "quick", "control": "duration", "mapping": {"node": "131", "input": "duration_seconds", "transform": "ltx_duration"}},
    {"id": "audio_enabled", "type": "boolean", "default": true, "label": "Audio", "section": "quick", "control": "audio", "mapping": {"node": "131", "input": "use_custom_audio", "transform": "ltx_audio_enabled", "targets": [{"node": "131", "input": "use_custom_audio"}, {"node": "131", "input": "inpaint_audio"}, {"node": "131", "input": "override_audio"}]}},
    {"id": "width", "type": "integer", "default": 0, "minimum": 0, "maximum": 4096, "label": "Resolved width", "section": "hidden", "control": "width", "mapping": {"node": "131", "input": "custom_width"}},
    {"id": "height", "type": "integer", "default": 0, "minimum": 0, "maximum": 4096, "label": "Resolved height", "section": "hidden", "control": "height", "mapping": {"node": "131", "input": "custom_height"}},
    {"id": "seed", "type": "integer", "default": -1, "minimum": -1, "maximum": 9223372036854775807, "label": "Seed", "section": "advanced", "control": "seed", "mapping": {"node": "30", "input": "noise_seed", "transform": "random_if_negative", "targets": [{"node": "30", "input": "noise_seed"}]}},
    {"id": "steps", "type": "integer", "default": 8, "minimum": 4, "maximum": 50, "label": "Steps", "help": "Higher values reduce temporal artifacts at the cost of speed.", "section": "advanced", "control": "slider", "mapping": {"node": "33", "input": "steps"}},
    {"id": "output_scale", "type": "number", "default": 1.0, "minimum": 0.25, "maximum": 1.0, "step": 0.05, "label": "Output scale", "help": "Keep at 1.0 for final renders. Lower values are faster previews.", "section": "advanced", "control": "slider", "mapping": {"node": "133", "input": "scale_by"}},
    {"id": "lora", "type": "string", "default": "None", "label": "LoRA", "help": "Optional LTX LoRA to apply through LTX Director.", "section": "advanced", "control": "lora", "mapping": {"node": "133", "input": "ic_lora_name"}},
    {"id": "lora_strength", "type": "number", "default": 1.0, "minimum": -2, "maximum": 2, "step": 0.05, "label": "LoRA strength", "section": "advanced", "control": "slider", "mapping": {"node": "133", "input": "ic_lora_strength"}},
    {"id": "model", "type": "string", "default": "redgraftLTX25Fast2K_ltx25RedgraftNSFW.safetensors", "label": "Quantized video model", "section": "advanced", "control": "model", "mapping": {"node": "134", "input": "model_name"}}
  ],
  "outputs": [{"id": "videos", "media_type": "video", "node": "37", "field": "video", "multiple": true}],
  "ui": {"icon": "video", "speed": "Slow", "quality": "High", "recommended": true}
}
