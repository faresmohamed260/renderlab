{
  "schema_version": "1.0",
  "id": "z-image-turbo",
  "version": "1.0.0",
  "display_name": "Z-Image Turbo",
  "description": "Fast Modal image generation for drafts and finished stills.",
  "category": "image",
  "model_family": "z-image-turbo",
  "tags": ["fast", "modal", "image"],
  "enabled": true,
  "workflow": {"path": "../workflows/reference_exports/z-image-turbo.api.json"},
  "capabilities": ["text_to_image", "negative_prompt", "seed", "steps", "cfg", "aspect_ratio", "batch_generation", "model_selection"],
  "result_actions": ["view", "download", "reuse_prompt", "reuse_settings", "use_as_reference", "favorite", "details"],
  "inputs": [
    {"id": "prompt", "type": "text", "required": true, "label": "Prompt", "help": "Describe the image you want to create.", "multiplicity": {"min": 1, "max": 1}, "mapping": {"node": "58:45", "input": "text"}},
    {"id": "negative_prompt", "type": "text", "required": false, "label": "Avoid", "section": "advanced", "multiplicity": {"min": 0, "max": 1}, "mapping": {"node": "58:58", "input": "text"}}
  ],
  "parameters": [
    {"id": "aspect_ratio", "type": "enum", "default": "1:1", "options": ["1:1", "4:3", "3:4", "16:9", "9:16"], "label": "Aspect ratio", "section": "quick", "control": "aspect_ratio", "mapping": {"transform": "aspect_to_dimensions", "targets": [{"node": "58:41", "input": "width"}, {"node": "58:41", "input": "height"}]}},
    {"id": "output_count", "type": "integer", "default": 1, "minimum": 1, "maximum": 4, "label": "Outputs", "section": "quick", "control": "output_count", "mapping": {"node": "58:41", "input": "batch_size"}},
    {"id": "seed", "type": "integer", "default": -1, "minimum": -1, "maximum": 9223372036854775807, "label": "Seed", "section": "advanced", "control": "seed", "mapping": {"node": "58:44", "input": "seed", "transform": "random_if_negative", "targets": [{"node": "58:44", "input": "seed"}]}},
    {"id": "steps", "type": "integer", "default": 9, "minimum": 1, "maximum": 50, "label": "Steps", "section": "advanced", "control": "slider", "mapping": {"node": "58:44", "input": "steps"}},
    {"id": "cfg", "type": "number", "default": 1.0, "minimum": 0, "maximum": 20, "step": 0.1, "label": "Guidance", "section": "advanced", "control": "slider", "mapping": {"node": "58:44", "input": "cfg"}},
    {"id": "model", "type": "string", "default": "z_image_turbo_bf16.safetensors", "label": "Diffusion model", "section": "advanced", "control": "model", "mapping": {"node": "58:46", "input": "unet_name"}}
  ],
  "outputs": [{"id": "images", "media_type": "image", "node": "9", "field": "images", "multiple": true}],
  "ui": {"icon": "image", "speed": "Fast", "quality": "Balanced", "recommended": true}
}
