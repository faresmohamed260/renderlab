{
  "schema_version": "1.0",
  "id": "reactor-face-swap",
  "version": "0.7.0-a2-local",
  "display_name": "ReActor Face Swap",
  "description": "Face swap on Modal using the project-modified ReActor node and its online-installed InsightFace model.",
  "category": "image",
  "model_family": "reactor",
  "tags": ["face-swap", "local-custom-node"],
  "enabled": true,
  "workflow": {"path": "../workflows/reference_exports/reactor-faceswap.api.json"},
  "capabilities": ["face_swap", "face_restore", "multi_reference"],
  "result_actions": ["view", "download", "use_as_reference", "favorite", "details"],
  "inputs": [
    {"id": "prompt", "type": "text", "required": false, "label": "Prompt", "mapping": {"node": "58", "input": "filename_prefix"}},
    {"id": "target", "type": "asset", "required": true, "label": "Target image", "role": "target", "accepted_media": ["image/*"], "multiplicity": {"min": 1, "max": 1}, "mapping": {"node": "57", "input": "image"}},
    {"id": "face", "type": "asset", "required": true, "label": "Source face", "role": "face", "accepted_media": ["image/*"], "multiplicity": {"min": 1, "max": 1}, "mapping": {"node": "11", "input": "image"}}
  ],
  "parameters": [
    {"id": "restore_visibility", "type": "number", "default": 1.0, "minimum": 0, "maximum": 1, "step": 0.05, "label": "Restore visibility", "section": "advanced", "control": "slider", "mapping": {"node": "10", "input": "face_restore_visibility"}},
    {"id": "codeformer_weight", "type": "number", "default": 0.9, "minimum": 0, "maximum": 1, "step": 0.05, "label": "CodeFormer weight", "section": "advanced", "control": "slider", "mapping": {"node": "10", "input": "codeformer_weight"}}
  ],
  "outputs": [{"id": "images", "media_type": "image", "node": "58", "field": "images", "multiple": true}],
  "ui": {"icon": "face", "speed": "Fast", "quality": "High", "recommended": false}
}
