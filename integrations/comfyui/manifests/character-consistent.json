{
  "schema_version": "1.0",
  "id": "character-consistent",
  "version": "1.0.0",
  "display_name": "Character Consistent",
  "description": "Character-sheet generation guided by a pose or composition image.",
  "category": "image",
  "model_family": "z-image-turbo-controlnet",
  "tags": ["character", "pose", "reference"],
  "enabled": false,
  "workflow": {"path": "../workflows/character_sheet_workflow.json"},
  "capabilities": ["image_to_image", "pose_reference", "negative_prompt", "seed", "steps", "cfg", "aspect_ratio"],
  "result_actions": ["view", "download", "reuse_prompt", "reuse_settings", "use_as_reference", "favorite", "details"],
  "inputs": [
    {"id": "prompt", "type": "text", "required": true, "label": "Prompt", "multiplicity": {"min": 1, "max": 1}, "mapping": {"node": "6", "input": "text"}},
    {"id": "negative_prompt", "type": "text", "required": false, "label": "Avoid", "section": "advanced", "multiplicity": {"min": 0, "max": 1}, "mapping": {"node": "5", "input": "text"}},
    {"id": "pose_reference", "type": "asset", "required": true, "label": "Pose", "role": "pose", "accepted_media": ["image/png", "image/jpeg", "image/webp"], "multiplicity": {"min": 1, "max": 1}, "mapping": {"node": "7", "input": "image"}}
  ],
  "parameters": [
    {"id": "aspect_ratio", "type": "enum", "default": "1:1", "options": ["1:1", "4:3", "3:4", "16:9", "9:16"], "label": "Aspect ratio", "section": "quick", "control": "aspect_ratio", "mapping": {"transform": "aspect_to_dimensions", "targets": [{"node": "15", "input": "width"}, {"node": "15", "input": "height"}]}},
    {"id": "output_count", "type": "integer", "default": 1, "minimum": 1, "maximum": 4, "label": "Outputs", "section": "quick", "control": "output_count", "mapping": {"node": "15", "input": "batch_size"}},
    {"id": "seed", "type": "integer", "default": -1, "minimum": -1, "maximum": 9223372036854775807, "label": "Seed", "section": "advanced", "control": "seed", "mapping": {"node": "3", "input": "seed", "transform": "random_if_negative", "targets": [{"node": "3", "input": "seed"}]}},
    {"id": "steps", "type": "integer", "default": 12, "minimum": 1, "maximum": 50, "label": "Steps", "section": "advanced", "control": "slider", "mapping": {"node": "3", "input": "steps"}},
    {"id": "cfg", "type": "number", "default": 1.0, "minimum": 0, "maximum": 20, "step": 0.1, "label": "Guidance", "section": "advanced", "control": "slider", "mapping": {"node": "3", "input": "cfg"}}
  ],
  "outputs": [{"id": "images", "media_type": "image", "node": "16", "field": "images", "multiple": true}],
  "ui": {"icon": "character", "speed": "Balanced", "quality": "High", "recommended": false}
}
