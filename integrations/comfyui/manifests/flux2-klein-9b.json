{
  "schema_version": "1.0",
  "id": "flux2-klein-9b",
  "version": "1.0.0",
  "display_name": "FLUX.2 Klein 9B",
  "description": "General-purpose quantized FLUX.2 Klein generation and reference-aware image editing.",
  "category": "image",
  "model_family": "flux2-klein",
  "tags": ["image", "edit", "quantized", "9b"],
  "enabled": true,
  "workflow": {"path": "../workflows/reference_exports/flux2-klein-controlnet.api.json"},
  "capabilities": ["text_to_image", "image_edit", "multi_reference", "reference_mentions", "auto_size", "model_selection", "seed", "steps", "cfg", "aspect_ratio", "resolution", "batch_size"],
  "result_actions": ["view", "download", "reuse_prompt", "reuse_settings", "use_as_reference", "favorite", "details"],
  "inputs": [
    {"id": "prompt", "type": "text", "required": true, "label": "Prompt", "mapping": {"node": "6", "input": "text"}},
    {"id": "negative_prompt", "type": "text", "required": false, "label": "Avoid", "section": "advanced", "mapping": {"node": "22", "input": "text"}},
    {"id": "image_reference", "type": "asset", "required": false, "label": "Images", "help": "Add reference images, then mention them as @Image 1, @Image 2, and so on.", "role": "image", "accepted_media": ["image/*"], "multiplicity": {"min": 0, "max": 32}, "mapping": {"transform": "flux_multi_reference", "targets": [{"node": "1", "input": "image"}]}, "present_mapping": {"node": "42", "input": "value"}, "present_value": false}
  ],
  "parameters": [
    {"id": "size_mode", "type": "enum", "default": "auto", "options": ["auto", "custom"], "label": "Sizing", "help": "Auto preserves the edit image's aspect ratio. Custom uses your selected canvas.", "section": "advanced", "control": "size_mode"},
    {"id": "aspect_ratio", "type": "enum", "default": "1:1", "options": ["1:1", "4:3", "3:4", "2:3", "3:2", "16:9", "9:16"], "label": "Canvas ratio", "help": "Used for new images and when Sizing is set to Custom.", "section": "advanced", "control": "aspect_ratio"},
    {"id": "resolution", "type": "enum", "default": 1024, "options": [512, 768, 1024, 1280], "label": "Long edge", "help": "Maximum output edge. Auto keeps the source ratio within this size.", "section": "advanced", "control": "resolution"},
    {"id": "width", "type": "integer", "minimum": 64, "maximum": 4096, "label": "Resolved width", "section": "hidden", "mapping": {"transform": "broadcast", "targets": [{"node": "8:18", "input": "width"}, {"node": "8:17", "input": "width"}]}},
    {"id": "height", "type": "integer", "minimum": 64, "maximum": 4096, "label": "Resolved height", "section": "hidden", "mapping": {"transform": "broadcast", "targets": [{"node": "8:18", "input": "height"}, {"node": "8:17", "input": "height"}]}},
    {"id": "text_to_image_mode", "type": "boolean", "default": true, "label": "Reference mode", "section": "hidden", "control": "mode", "mapping": {"node": "42", "input": "value"}},
    {"id": "seed", "type": "integer", "default": -1, "minimum": -1, "maximum": 9223372036854775807, "label": "Seed", "section": "advanced", "control": "seed", "mapping": {"node": "7", "input": "noise_seed", "transform": "random_if_negative", "targets": [{"node": "7", "input": "noise_seed"}]}},
    {"id": "steps", "type": "integer", "default": 4, "minimum": 1, "maximum": 50, "label": "Steps", "section": "advanced", "control": "slider", "mapping": {"node": "8:17", "input": "steps"}},
    {"id": "cfg", "type": "number", "default": 1.0, "minimum": 0, "maximum": 20, "step": 0.1, "label": "Guidance", "help": "Higher values follow the prompt more literally; 1.0 is recommended for Klein.", "section": "advanced", "control": "slider", "mapping": {"node": "8:15", "input": "cfg"}},
    {"id": "batch_size", "type": "integer", "default": 1, "minimum": 1, "maximum": 4, "label": "Outputs", "help": "Generate multiple variations in one run. Higher values use more VRAM.", "section": "advanced", "control": "slider", "mapping": {"node": "8:18", "input": "batch_size"}},
    {"id": "model", "type": "string", "default": "darkBeast30BF16INT8_dbkleinv2BFS.safetensors", "label": "Quantized 9B model", "section": "advanced", "control": "model", "mapping": {"node": "50", "input": "unet_name"}}
  ],
  "outputs": [{"id": "images", "media_type": "image", "node": "9", "field": "images", "multiple": true}],
  "ui": {"icon": "image", "speed": "Medium", "quality": "High", "recommended": true}
}
