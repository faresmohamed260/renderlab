# RenderLab local/runtime environment contract
# Copy to .env.local for local development and fill only the values your workflow requires.
# Never commit real credentials.

# Supabase (public browser configuration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server-side)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (preferred runtime names)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=

# Generation worker routing
RENDERLAB_UPSCALE_WORKER_GATEWAY_URL=

# Optional external generation backend: configure both or neither.
RENDERLAB_GENERATION_BACKEND_URL=
RENDERLAB_GENERATION_BACKEND_TOKEN=

# Internal scheduled/reconciliation routes
RENDERLAB_GENERATION_RECONCILER_SECRET=
RENDERLAB_MAINTENANCE_SECRET=
RENDERLAB_MAINTENANCE_BATCH_LIMIT=
CRON_SECRET=

# Closed-beta access control
RENDERLAB_CLOSED_BETA_ACCESS_ENFORCEMENT_ENABLED=true

# Transactional email / account lifecycle
RESEND_API_KEY=

# Compatibility aliases used by some scripts and storage helpers.
# Prefer the CLOUDFLARE_R2_* names above for application runtime configuration.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Test-only RENDERLAB_TEST_* variables are intentionally omitted here.
# They are supplied by the relevant verification workflows when needed.
