# RenderLab frontend configuration
#
# Keep secrets out of Vite env vars. Every VITE_* value is visible in the browser.

# Same-origin API prefix used by Vercel rewrites or functions.
VITE_RENDERLAB_API_PREFIX=/studio

# Optional absolute API origin for preview/local environments.
# Example: https://api.renderlab.example
VITE_RENDERLAB_API_BASE=

# Server-side deployment variables expected by the RenderLab backend layer.
# Configure these in Vercel/Supabase/Cloudflare dashboards, not in client code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_BASE_URL=
