{
  "name": "renderlab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "doctor": "node scripts/verify-developer-toolchain.mjs",
    "verify:text-policy": "node scripts/verify-text-policy.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/verify-vercel-env.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint src scripts tests",
    "typecheck": "tsc --noEmit --pretty false --incremental false",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:unit:coverage": "c8 --config .c8rc.json node --test tests/unit/*.test.mjs",
    "test:ui": "playwright test",
    "verify:engineering-quality": "node scripts/verify-engineering-quality.mjs",
    "verify:unit-coverage": "node scripts/verify-unit-coverage-report.mjs",
    "verify:ui-purity": "node scripts/verify-ui-purity.mjs",
    "verify:modal-project-ownership": "node scripts/verify-modal-project-ownership.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/s3-request-presigner": "3.1116.0",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.34.0",
    "motion": "13.1.1",
    "next": "16.3.8",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "c8": "12.0.0",
    "oxlint": "1.81.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
